# Copie para infra/.env e preencha. Este arquivo é lido pelo docker-compose.
# infra/.env contém segredos e está no .gitignore — nunca versione.

# ── Banco ─────────────────────────────────────────────────────────────────
# `db` é o nome do serviço Postgres dentro da rede do Supabase self-hosted,
# resolvido pelo DNS interno do Docker. A senha é a POSTGRES_PASSWORD que você
# definiu no .env do Supabase.
#
# Diferente do Supabase gerenciado, aqui as duas URLs são IGUAIS: a conexão é
# direta ao Postgres, sem PgBouncer no caminho, então não existe a distinção
# entre pooler de transação (6543) e de sessão (5432).
DATABASE_URL="postgresql://postgres:SUA_POSTGRES_PASSWORD@db:5432/postgres?schema=public"
DIRECT_URL="postgresql://postgres:SUA_POSTGRES_PASSWORD@db:5432/postgres?schema=public"

# Nome da rede Docker criada pelo compose do Supabase.
# Confira com: docker network ls | grep supabase
SUPABASE_NETWORK="supabase_default"

# ── Autenticação ──────────────────────────────────────────────────────────
# Mantenha o MESMO valor usado hoje na Vercel para não invalidar as sessões
# abertas. Trocar não causa dano — só obriga todo mundo a logar de novo (as
# senhas são hashes bcrypt no banco e não dependem desta chave).
JWT_SECRET=""

# ── E-mail ────────────────────────────────────────────────────────────────
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# ── URL pública ───────────────────────────────────────────────────────────
# O hostname do túnel Cloudflare. Usado nos links dos e-mails de boas-vindas.
APP_URL="https://fluxo.seudominio.com.br"

# ── Túnel ─────────────────────────────────────────────────────────────────
# Token do tunnel, gerado no painel Zero Trust da Cloudflare
# (Networks > Tunnels > Create a tunnel > Docker). É um segredo: quem tiver
# ele consegue publicar tráfego pelo seu túnel.
TUNNEL_TOKEN=""
