# Supabase — Transaction Pooler (usado em runtime / Vercel)
DATABASE_URL="postgresql://postgres.[ref]:[senha]@aws-0-[regiao].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Supabase — Conexão Direta (usado pelo prisma migrate)
DIRECT_URL="postgresql://postgres.[ref]:[senha]@db.[ref].supabase.co:5432/postgres"

# JWT — troque por uma string longa e aleatória em produção
JWT_SECRET="troque-por-string-segura-em-producao"
