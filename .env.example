# ── Banco de dados (Supabase / Postgres) ──────────────────────────────
# Mesmo host nas duas: o que muda é a PORTA, e ela define o modo.
#
#   6543 = transaction pooler (PgBouncer) → runtime da aplicação
#   5432 = session pooler                 → somente prisma migrate
#
# Migrations exigem prepared statements e advisory locks, que o pooler de
# transação não suporta. Apontar migrations para a 6543 faz o CLI travar
# indefinidamente, sem mensagem de erro.

# Runtime (aplicação / Vercel)
DATABASE_URL="postgresql://postgres.[ref]:[senha]@aws-1-us-east-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Migrations (prisma migrate / db push) — lido por prisma.config.ts
# Não usar db.[ref].supabase.co: é IPv6-only sem o add-on de IPv4 e trava
# em rede IPv4 — sem erro, só pendura.
DIRECT_URL="postgresql://postgres.[ref]:[senha]@aws-1-us-east-2.pooler.supabase.com:5432/postgres"

# ── Autenticação ──────────────────────────────────────────────────────
# JWT — troque por uma string longa e aleatória em produção
JWT_SECRET="troque-por-string-segura-em-producao"

# ── E-mail (Gmail SMTP) ───────────────────────────────────────────────
# Usado no envio do e-mail de boas-vindas ao criar usuário.
# GMAIL_APP_PASSWORD é uma "senha de app" do Google, não a senha da conta.
GMAIL_USER="seuemail@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# URL pública do sistema (usada nos links do e-mail)
APP_URL="https://grupoello-fc.vercel.app"