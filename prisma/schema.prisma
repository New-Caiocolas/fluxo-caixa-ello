generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  GESTOR
  OPERADOR
}

model User {
  id                 String   @id @default(cuid())
  name               String
  email              String   @unique
  password           String
  role               Role     @default(OPERADOR)
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  lancamentos Lancamento[]
  auditLogs   AuditLog[]
}

model Filial {
  id        String   @id @default(cuid())
  nome      String
  codigo    String   @unique
  ativa     Boolean  @default(true)
  createdAt DateTime @default(now())

  lancamentos  Lancamento[]
  saldos       Saldo[]
  funcionarios Funcionario[]
  faturamentos Faturamento[]
  metas        Meta[]
}

enum TipoGrupo {
  ENTRADA
  SAIDA
}

/// Define como o grupo participa dos indicadores de fluxo de caixa.
/// Sem isso, um grupo criado pelo usuário não entraria em conta nenhuma e os
/// lançamentos dele sumiriam silenciosamente dos relatórios.
enum Classificacao {
  /// Entra como receita (base do fluxo operacional). Hoje: grupo 1.
  RECEBIMENTO
  /// Subtrai do fluxo operacional. Hoje: grupos 4 a 12.
  CUSTO_OPERACIONAL
  /// Soma no fluxo livre respeitando o sinal do lançamento. Hoje: grupo 13.
  RESULTADO_FINANCEIRO
  /// Subtrai do fluxo livre. Hoje: grupo 14.
  INVESTIMENTO
  /// Fora de todos os indicadores — precisa ser escolha explícita.
  NEUTRO
}

model Grupo {
  id            Int           @id
  nome          String
  tipo          TipoGrupo
  ordem         Int
  classificacao Classificacao @default(NEUTRO)

  /// Grupo cujos subgrupos têm as duas direções (ex.: juros pagos x recebidos).
  /// Quando true o usuário escolhe o tipo do lançamento; quando false o backend
  /// deriva o tipo de `tipo` e ignora o que vier do cliente.
  permiteAmbosTipos Boolean @default(false)

  /// Desativado some dos formulários mas preserva o histórico. Exclusão de
  /// verdade é impossível: Lancamento tem FK RESTRICT para cá.
  ativo Boolean @default(true)

  subgrupos   Subgrupo[]
  lancamentos Lancamento[]
}

model Subgrupo {
  id      String  @id @default(cuid())
  grupoId Int
  nome    String
  ordem   Int
  ativo   Boolean @default(true)

  grupo       Grupo        @relation(fields: [grupoId], references: [id])
  lancamentos Lancamento[]

  @@index([grupoId])

}

model Lancamento {
  id          String   @id @default(cuid())
  filialId    String
  data        DateTime
  grupoId     Int
  subgrupoId  String?
  descricao   String
  valor       Decimal @db.Decimal(14, 2)
  tipo        TipoLancamento
  observacao  String?
  competencia String

  /// Chave de deduplicação do extrato importado. Nula nos lançamentos
  /// digitados à mão.
  ///
  /// NÃO é o FITID puro: medido em extrato real da Caixa, 65 transações
  /// traziam só 53 FITIDs distintos (o campo espelha o CHECKNUM). Deduplicar
  /// por ele descartaria 12 lançamentos em silêncio. A chave combina FITID,
  /// data, valor e descrição. Ver `montarChave` em lib/ofx.ts.
  chaveImportacao String? @unique
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  filial    Filial     @relation(fields: [filialId], references: [id])
  grupo     Grupo      @relation(fields: [grupoId], references: [id])
  subgrupo  Subgrupo?  @relation(fields: [subgrupoId], references: [id])
  user      User       @relation(fields: [userId], references: [id])
  auditLogs AuditLog[]

  @@index([filialId, competencia])
  @@index([data])
}

enum TipoLancamento {
  ENTRADA
  SAIDA
}

model Saldo {
  id            String   @id @default(cuid())
  filialId      String
  data          DateTime
  saldoInicial  Decimal @db.Decimal(14, 2)  @default(0)
  saldoFinal    Decimal @db.Decimal(14, 2)  @default(0)
  totalEntradas Decimal @db.Decimal(14, 2)  @default(0)
  totalSaidas   Decimal @db.Decimal(14, 2)  @default(0)
  competencia   String

  filial Filial @relation(fields: [filialId], references: [id])

  @@unique([filialId, data])
  @@index([filialId, competencia])
}

model Funcionario {
  id          String   @id @default(cuid())
  filialId    String
  nome        String
  cargo       String
  salarioBase Decimal @db.Decimal(14, 2)
  trienio     Decimal @db.Decimal(5, 4)  @default(0)
  ativo       Boolean  @default(true)
  admissao    DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  filial Filial      @relation(fields: [filialId], references: [id])
  folhas FolhaItem[]

  @@index([filialId])

}

model Folha {
  id          String   @id @default(cuid())
  competencia String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  itens FolhaItem[]

  // Uma folha por competência. A API faz findFirst({where:{competencia}});
  // sem esta restrição, duas folhas do mesmo mês fariam a consulta escolher
  // uma arbitrariamente e a outra viraria dado órfão.
  @@unique([competencia])

}

model FolhaItem {
  id            String  @id @default(cuid())
  folhaId       String
  funcionarioId String
  salarioBase   Decimal @db.Decimal(14, 2)
  comissao      Decimal @db.Decimal(14, 2) @default(0)
  trienio       Decimal @db.Decimal(14, 2) @default(0)
  dsr           Decimal @db.Decimal(14, 2) @default(0)
  totalBruto    Decimal @db.Decimal(14, 2)
  inssPatronal  Decimal @db.Decimal(14, 2) @default(0)
  entidades     Decimal @db.Decimal(14, 2) @default(0)
  fgts          Decimal @db.Decimal(14, 2) @default(0)
  totalEncargos Decimal @db.Decimal(14, 2)
  totalPagar    Decimal @db.Decimal(14, 2)

  folha       Folha       @relation(fields: [folhaId], references: [id])
  funcionario Funcionario @relation(fields: [funcionarioId], references: [id])

  // O mesmo funcionário não pode aparecer duas vezes na mesma folha.
  @@unique([folhaId, funcionarioId])
  @@index([funcionarioId])

}

model Faturamento {
  id          String   @id @default(cuid())
  filialId    String
  competencia String
  valorNF     Decimal @db.Decimal(14, 2)
  descricao   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  filial Filial @relation(fields: [filialId], references: [id])

  @@index([filialId, competencia])
}

model Meta {
  id          String  @id @default(cuid())
  filialId    String
  nome        String
  descricao   String?
  tipo        String
  valorMeta   Decimal @db.Decimal(5, 2)
  operador    String
  grupoRef    Int?
  baseCalculo String
  ativa       Boolean @default(true)

  filial Filial @relation(fields: [filialId], references: [id])

  @@unique([filialId, tipo])
}

model AuditLog {
  id           String   @id @default(cuid())
  userId       String
  lancamentoId String?
  acao         String
  dadosAntes   Json?
  dadosDepois  Json?
  createdAt    DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id])
  lancamento Lancamento? @relation(fields: [lancamentoId], references: [id])

  @@index([userId])
  @@index([lancamentoId])
  @@index([createdAt])

}
