# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files — o glob amplo evita que variantes com credenciais
# (.env.bak, .env.producao, .env.old) escapem por não casarem com o padrão.
.env*
!.env.example

# vercel
.vercel

# dumps da migração para self-host — contêm dados financeiros reais e senhas
# em hash. Nunca versionar.
*.sql
!prisma/migrations/**/*.sql
!scripts/*.sql
*.dump
/backups/

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma
*.db
*.db-journal

# AI / dev tools
.claude/
.claude-flow/
.swarm/
.mcp.json
